#!/usr/bin/env bash
# Pre-commit checkpoints: only the gates that match staged files, and no
# tests. CI owns the full matrix (scripts/check.sh); pre-push runs the tests.
# The index-build gate is the exception: it validates what a commit would
# actually contain, so it belongs here more than in CI.
set -euo pipefail
cd "$(dirname "$0")/../.."

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[[ -z $staged ]] && exit 0

git diff --cached --check

go_files=$(printf '%s\n' "$staged" | grep -E '\.go$' || true)
if [[ -n $go_files ]]; then
  unformatted=$(printf '%s\n' "$go_files" | xargs gofmt -l || true)
  if [[ -n $unformatted ]]; then
    printf 'pre-commit: not gofmt-clean (run gofmt -w):\n%s\n' "$unformatted" >&2
    exit 1
  fi
  go vet ./...
fi

# Catches a build input left unstaged: the index, not the worktree, is what a
# clone receives.
if printf '%s\n' "$staged" | grep -qE '\.go$|(^|/)go\.(mod|sum)$|\.o$'; then
  bash scripts/verify-index-build.sh
fi

if printf '%s\n' "$staged" | grep -qE '\.sh$|^scripts/git-hooks/'; then
  bash scripts/verify-shell-syntax.sh
fi

if [[ -n $staged ]] && printf '%s\n' "$staged" | grep -qE '\.md$'; then
  bash scripts/verify-agent-notes.sh
  bash scripts/verify-translation-pair.sh --staged
  bash scripts/verify-md-links.sh
fi
