# Pinned guest images. Checksums are the publisher's own: openEuler ships a
# .sha256sum next to the compressed image, Ubuntu a SHA256SUMS per serial. The
# fallback is pinned to a serial because cloud-images.ubuntu.com/noble/current
# moves. Bump a pin only together with the Agent Note that records the boot and
# BTF evidence for the new image.

OPENEULER_URL=https://repo.openeuler.org/openEuler-24.03-LTS/virtual_machine_img/x86_64/openEuler-24.03-LTS-x86_64.qcow2.xz
OPENEULER_SHA256=c6af522d36d659b66da668cc4eb86b032a9cff05a95a0e37505a63e70ed585dc
OPENEULER_DISK=openEuler-24.03-LTS-x86_64.qcow2

UBUNTU_URL=https://cloud-images.ubuntu.com/noble/20261017/noble-server-cloudimg-amd64.img
UBUNTU_SHA256=04e8f2461a16a44e78a370284471f29616cdd9baf1893df25807b71f985b6c94
UBUNTU_DISK=noble-server-cloudimg-amd64.img
